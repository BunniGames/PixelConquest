-- The ladder, lowest first. A profile stores the rank by INDEX into this list
-- (Ranked.rankOf), so it is append-only at the top and never reordered.
RankEmblems.ORDER = {
	"recruit",
	"soldier",
	"sergeant",
	"lieutenant",
	"captain",
	"major",
	"colonel",
	"general",
	"emperor",
 } :: { string }

local AssetService = game:GetService("AssetService")
local cache: { [string]: EditableImage } = {}

function RankEmblems.editable(id: string): EditableImage?
	local hit = cache[id]
	if hit then
		return hit
	end
	local art = RankEmblems.ART[id]
	if not art then
		return nil
	end
	local n = RankEmblems.S
	local img = AssetService:CreateEditableImage({ Size = Vector2.new(n, n) })
	local buf = buffer.create(n * n * 4)
	for y = 1, n do
		local row = art[y]
		for x = 1, n do
			local rgba = P[string.sub(row, x, x)]
			local o = ((y - 1) * n + (x - 1)) * 4
			buffer.writeu8(buf, o + 0, rgba[1])
			buffer.writeu8(buf, o + 1, rgba[2])
			buffer.writeu8(buf, o + 2, rgba[3])
			buffer.writeu8(buf, o + 3, rgba[4])
		end
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(n, n), buf)
	cache[id] = img
	return img
end

-- An ImageLabel showing an emblem, or nil for an unknown id. The caller owns
-- position and size; this owns the two properties that are not optional.
function RankEmblems.image(parent: Instance, name: string, id: string): ImageLabel?
	local img = RankEmblems.editable(id)
	if not img then
		return nil
	end
	local lbl = Instance.new("ImageLabel")
	lbl.Name = name
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.ImageContent = Content.fromObject(img)
	lbl.ScaleType = Enum.ScaleType.Fit
	lbl.ResampleMode = Enum.ResamplerMode.Pixelated
	lbl.Parent = parent
	return lbl
end

return RankEmblems
