--!strict
-- Conquest :: Scenarios
-- The HISTORICAL roster: a predrawn map laid over one of the Maps entries --
-- which nation holds every playable tile when the round starts, and the
-- cities and ports each one opens with, at what level. Generated by
-- mapgen/historical.py the way the map modules are generated by
-- build_maps.py; this file is the roster, the decoder and the lookups the
-- sim, the server and the /world command need.
--
-- A SCENARIO IS KEYED BY ITS MODE AND THE MAP IT IS DRAWN ON. "historical"
-- (Modes.BY_ID.historical) is the original roster -- 1938 on the World, the
-- Korean War on Korea -- and every scenario after it is a mode of its own
-- (2026-09-24, owner: "For world map I want WW1, for europe, i want napoleanic
-- wars. Want a pacific WW2 scenerio that focuses more on navy"): `ww1` on the
-- World, `napoleonic` on Europe, `pacificwar` on the Pacific. A mode is what a
-- lobby card, a match record and a command already carry, so a second
-- scenario on the World needed no new field anywhere -- only a second mode.
-- Every lookup takes the mode and defaults to "historical".
--
-- What the sim does with one is in Sim's historical block: every nation is an
-- AI empire from the first tick, a click during the spawn phase CLAIMS a
-- playable one, and at the phase's end each claim transfers the nation --
-- land, buildings, army, treasury -- to the person who made it.

local Config = require(script.Parent.Config)
local WW2Scenario = require(script.Parent.WW2Scenario)
local KoreanWarScenario = require(script.Parent.KoreanWarScenario)
local WW1Scenario = require(script.Parent.WW1Scenario)
local NapoleonicScenario = require(script.Parent.NapoleonicScenario)
local PacificWarScenario = require(script.Parent.PacificWarScenario)
local WW1EuropeScenario = require(script.Parent.WW1EuropeScenario)

local N = Config.NUM_TILES

export type Structure = {
	t: number, -- tile
	k: number, -- kind: 1 city, 2 port (Units.CITY / Units.PORT)
	l: number, -- level
	n: string, -- name, for the log and a future label
}

export type Nation = {
	id: string,
	name: string,
	short: string,
	-- Whether a person may pick it. A minor is an AI nation for the whole
	-- round and paints in the AI ramp; a playable nation carries a colour.
	playable: boolean,
	color: { number }?,
	-- The tile the camera lands on and the spacing rule measures from.
	capital: number,
	tiles: number,
	structures: { Structure },
}

export type Scenario = {
	ID: string,
	NAME: string,
	YEAR: number,
	MAP: string,
	BLURB: string,
	WIDTH: number,
	HEIGHT: number,
	NATION_COUNT: number,
	PLAYABLE_COUNT: number,
	CLAIMED_TILES: number,
	RUN_COUNT: number,
	-- Nation-index order: MASK's values index into it, 0 is open land.
	NATIONS: { Nation },
	MASK: string,
}

local Scenarios = {}

Scenarios.MODE_ID = "historical"

Scenarios.BY_MAP = {
	world = WW2Scenario,
	-- THE KOREAN WAR (2026-09-15), on the two-empire Korea map. The only
	-- scenario with no AI minors -- both nations are playable, because the map
	-- itself is a 1v1 (KoreaMap.MAX_EMPIRES). Borders are the 38th parallel of
	-- 1945 rather than a dataset: see mapgen/historical.py `rings`.
	korea = KoreanWarScenario,
} :: { [string]: Scenario }

-- mode id -> map id -> scenario. BY_MAP above is the "historical" row, kept
-- under its old name because it is what every caller before 2026-09-24 read.
Scenarios.BY_MODE = {
	historical = Scenarios.BY_MAP,
	-- THE GREAT WAR, summer 1914: nine powers on the World, and (2026-09-24,
	-- owner: "make a ww1 historical scenerio for europe as well") the eight
	-- on the Europe frame, Serbia among them. One mode, the card picks the map.
	ww1 = { world = WW1Scenario, europe = WW1EuropeScenario },
	-- 1800, the First Consul against the Second Coalition: eight powers.
	napoleonic = { europe = NapoleonicScenario },
	-- 7 December 1941, and the NAVAL one: every harbour at level 2-3, so
	-- each nation opens with a fleet, and the scenario's NAVY table lifts
	-- the gunboat ceiling (Sim.loadScenario -> Gunboats).
	pacificwar = { pacific = PacificWarScenario },
} :: { [string]: { [string]: Scenario } }

function Scenarios.forMap(mapId: string, modeId: string?): Scenario?
	local row = Scenarios.BY_MODE[modeId or Scenarios.MODE_ID]
	return row and row[mapId] or nil
end

function Scenarios.exists(mapId: string, modeId: string?): boolean
	return Scenarios.forMap(mapId, modeId) ~= nil
end

-- The maps that have one in this mode, sorted, for the command's refusal line.
function Scenarios.mapIds(modeId: string?): { string }
	local ids = {}
	for id in Scenarios.BY_MODE[modeId or Scenarios.MODE_ID] or {} do
		table.insert(ids, id)
	end
	table.sort(ids)
	return ids
end

-- Every (map, mode) that has a scenario, in a FIXED order (mode then map,
-- both sorted) so every server enumerates the lobby's pairings identically.
function Scenarios.pairs(): { { map: string, mode: string } }
	local modes = {}
	for g in Scenarios.BY_MODE do
		table.insert(modes, g)
	end
	table.sort(modes)
	local out = {}
	for _, g in modes do
		for _, m in Scenarios.mapIds(g) do
			table.insert(out, { map = m, mode = g })
		end
	end
	return out
end

function Scenarios.nation(scn: Scenario, k: number): Nation?
	return scn.NATIONS[k]
end

-- ------------------------------------------------------------- decoding --
-- MASK is (nation, run) varint PAIRS in the land mask's base-32 alphabet
-- (MapGen.decodeMask reads the same digits; historical.py encode_pairs writes
-- them). Cached per scenario: it is data, not noise, so every round on the
-- map and every client would otherwise decode the same 480k tiles again.

local ALPHABET = "0123456789ABCDEFGHIJKLMNOPQRSTUVWXYZabcdefghijklmnopqrstuvwxyz-_"
local DECODE: { [number]: number } = {}
for i = 1, #ALPHABET do
	DECODE[string.byte(ALPHABET, i)] = i - 1
end

local cache: { [string]: buffer } = {}

-- The nation index per tile, 0 for open land. Only meaningful on playable
-- land: the generator zeroes water and out-of-bounds ground before encoding,
-- and Sim.loadScenario re-checks isPassable before painting anyway.
function Scenarios.nationMask(scn: Scenario): buffer
	local hit = cache[scn.ID]
	if hit then
		return hit
	end
	assert(
		scn.WIDTH == Config.MAP_W and scn.HEIGHT == Config.MAP_H,
		scn.ID .. " frame does not match Config"
	)
	local mask = buffer.create(N)
	local s = scn.MASK
	local len = #s
	local pos = 1
	local idx = 0
	local function varint(): number
		local v, shift = 0, 0
		while true do
			local d = DECODE[string.byte(s, pos)]
			pos += 1
			v += bit32.lshift(bit32.band(d, 31), shift)
			shift += 5
			if d < 32 then
				break
			end
		end
		return v
	end
	while pos <= len do
		local v = varint()
		local n = varint()
		if v ~= 0 and n > 0 then
			buffer.fill(mask, idx, v, n)
		end
		idx += n
	end
	assert(idx == N, scn.ID .. " mask decodes to " .. idx .. " tiles, expected " .. N)
	cache[scn.ID] = mask
	return mask
end

function Scenarios.nationAt(scn: Scenario, tile: number): number
	if tile < 0 or tile >= N then
		return 0
	end
	return buffer.readu8(Scenarios.nationMask(scn), tile)
end

return Scenarios
