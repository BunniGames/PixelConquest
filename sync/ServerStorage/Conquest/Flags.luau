--!strict
-- Conquest :: Flags  (generated by mapgen/flags.py -- do not hand edit)
--
-- The pixel flag for every nation in the historical scenario, drawn to sit
-- beside a player's name. Nothing here is an uploaded image: a flag is painted
-- into an EditableImage on demand, the same path Renderer uses for the map, so
-- fifty-seven flags cost fifty-seven asset uploads of zero and stay editable as
-- text in mapgen/flags.py.
--
-- THE GRID IS 18x12. 18 divides into thirds and halves exactly and 12 into
-- thirds, quarters and sixths, so no band on any tricolour is a pixel wider
-- than its neighbours -- which is the whole difference between a flag and a
-- smear at this size. 18:12 is also 3:2, the real ratio of most of them.
--
-- RENDER THEM PIXELATED. `Flags.image` already does; any other render site
-- must, or the engine bilinear-filters an 18-pixel flag into a grey bruise.
--
-- Modern flags, not the 1938 scenario's: the roster is sovereign states.

local Flags = {}

Flags.W = 18
Flags.H = 12

-- The recommended on-screen size beside a name: the standings row is 34px tall
-- and its avatar disc is 26, so a flag matching the disc's height reads as part
-- of the same row rather than as a second, competing badge.
Flags.DISPLAY_W = 22
Flags.DISPLAY_H = 15

-- One palette for all of them, keyed by the character used in ART below.
-- Per-flag reds would put fifty-seven slightly different reds down one
-- standings board, which reads as a rendering fault rather than as countries.
local P: { [string]: { number } } = {
	["."] = { 0, 0, 0, 0 }, -- transparent -- Nepal's notch, and nothing else
	["w"] = { 245, 245, 245, 255 }, -- white
	["k"] = { 26, 26, 30, 255 }, -- black
	["r"] = { 214, 42, 54, 255 }, -- red
	["d"] = { 158, 28, 48, 255 }, -- crimson / dark red
	["m"] = { 124, 34, 50, 255 }, -- maroon
	["o"] = { 240, 138, 43, 255 }, -- orange
	["y"] = { 247, 202, 60, 255 }, -- yellow / gold
	["g"] = { 44, 158, 82, 255 }, -- green
	["e"] = { 20, 108, 58, 255 }, -- dark green
	["c"] = { 110, 190, 235, 255 }, -- sky blue
	["b"] = { 40, 92, 196, 255 }, -- blue
	["n"] = { 22, 46, 106, 255 }, -- navy
	["s"] = { 186, 193, 201, 255 }, -- silver / grey
	["u"] = { 122, 74, 36, 255 }, -- brown
}

