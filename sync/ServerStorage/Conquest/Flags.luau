-- "No flag", which is a real value and not an absence: it is what every account
-- starts on and what a player goes back to by pressing the flag they are
-- already wearing. Stored on the profile as this exact string.
Flags.NONE = ""

-- The nation's name for a flag id, or "" for one this build does not have.
-- Written long rather than as `(id and NAMES[id]) or ""`, which types as
-- `false | string` under --!strict and is a real error rather than a nitpick.
function Flags.name(id: string?): string
	if id == nil then
		return ""
	end
	return Flags.NAMES[id] or ""
end

-- =============================================================== rendering ==

local AssetService = game:GetService("AssetService")

-- Built once per nation and kept: a flag never changes, and a standings board
-- rebuilding four of these five times a second would allocate an EditableImage
-- per row per update.
local cache: { [string]: EditableImage } = {}

-- The painted flag for a nation id, or nil if that nation has no art. nil and
-- not a blank: a caller that gets nil can fall back to the coloured disc it
-- already draws, where a blank flag is an empty hole beside a name.
function Flags.editable(id: string): EditableImage?
	local hit = cache[id]
	if hit then
		return hit
	end
	local art = Flags.ART[id]
	if not art then
		return nil
	end

	local img = AssetService:CreateEditableImage({ Size = Vector2.new(Flags.W, Flags.H) })
	local buf = buffer.create(Flags.W * Flags.H * 4)
	for y = 1, Flags.H do
		local row = art[y]
		for x = 1, Flags.W do
			local rgba = P[string.sub(row, x, x)]
			local o = ((y - 1) * Flags.W + (x - 1)) * 4
			buffer.writeu8(buf, o + 0, rgba[1])
			buffer.writeu8(buf, o + 1, rgba[2])
			buffer.writeu8(buf, o + 2, rgba[3])
			buffer.writeu8(buf, o + 3, rgba[4])
		end
	end
	img:WritePixelsBuffer(Vector2.zero, Vector2.new(Flags.W, Flags.H), buf)
	cache[id] = img
	return img
end

-- An ImageLabel showing a nation's flag, or nil if it has none. The caller
-- owns position and size; this owns the two properties that are not optional.
function Flags.image(parent: Instance, name: string, id: string): ImageLabel?
	local img = Flags.editable(id)
	if not img then
		return nil
	end
	local lbl = Instance.new("ImageLabel")
	lbl.Name = name
	lbl.BackgroundTransparency = 1
	lbl.BorderSizePixel = 0
	lbl.ImageContent = Content.fromObject(img)
	-- Fit, not Stretch: Nepal is not a rectangle and every other flag has a
	-- ratio worth keeping.
	lbl.ScaleType = Enum.ScaleType.Fit
	-- The one property that makes this pixel art instead of a blur.
	lbl.ResampleMode = Enum.ResamplerMode.Pixelated
	lbl.Parent = parent
	return lbl
end

function Flags.has(id: string): boolean
	return Flags.ART[id] ~= nil
end

return Flags
